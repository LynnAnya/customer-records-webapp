# Copy to .env and fill in. Never commit .env.
DEBUG=True
# Generate: uv run python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
SECRET_KEY=change-me
ALLOWED_HOSTS=localhost,127.0.0.1
# Local Postgres (uses your macOS user, no password). On Render this is set for you.
DATABASE_URL=postgres://localhost:5432/customer_records
