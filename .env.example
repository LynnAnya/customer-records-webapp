# Settings, read from environment variables.
#   Laptop: copy this file to .env and fill it in. Never commit .env.
#   Live (Render): type the same names into Render -> your web service ->
#   Environment. The .env file is never uploaded.

# --- Needed everywhere -----------------------------------------------------

# Laptop: True (detailed error pages). Live: False, or leave it out (default False).
DEBUG=True

# A long random value. Live gets its own NEW key, never this one.
# Generate: uv run python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
SECRET_KEY=change-me

# Addresses this site answers to, comma separated.
# Laptop: localhost,127.0.0.1 (add your Wi-Fi address to test on a phone).
# Live:   your-service.onrender.com (later also your custom domain).
ALLOWED_HOSTS=localhost,127.0.0.1

# Laptop: local Postgres (your macOS user, no password).
# Live:   the connection string from Neon (it ends with ?sslmode=require...).
DATABASE_URL=postgres://localhost:5432/customer_records

# The company name shown in the app (tab titles, sidebar, login, QR form).
# Set the real name here and in Render, never in the code. Default: Customer Records
# SITE_NAME=Customer Records

# --- Live only (leave out on a laptop) ---------------------------------------

# The site's https address(es), comma separated, e.g.
# https://your-service.onrender.com
# CSRF_TRUSTED_ORIGINS=

# True on Render: read each visitor's real address from Cloudflare's
# CF-Connecting-IP header (QR rate limit, login lockout, activity log).
# TRUST_CF_CONNECTING_IP=True

# HSTS in seconds. Starts at 3600 (1 hour); set 31536000 (1 year) only once
# the custom domain works on https.
# SECURE_HSTS_SECONDS=3600

# --- Optional ----------------------------------------------------------------

# QR form: saved forms allowed per internet address per hour (default 20).
# REGISTRATION_RATE_LIMIT_PER_HOUR=20

# Seconds a database connection is kept (default 60; Neon sleeps after 300).
# CONN_MAX_AGE=60

# Django's log level on the console (default INFO).
# DJANGO_LOG_LEVEL=INFO
